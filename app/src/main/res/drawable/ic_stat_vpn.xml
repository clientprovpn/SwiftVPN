<!--
  Notification small icon — CONNECTED.  8a Orbit, weighted up for the status bar.

  Drawn at roughly 18-24 px and always monochrome, so relative to the tile the
  stroke goes 2.4 -> 2.7 and the nucleus 2.8 -> 3.0. The arcs keep their exact
  radius and angles: thickening the strokes rather than shrinking the geometry
  is what keeps the mark recognisable as the same orbit at half the size.

  See ic_tile_vpn for the Bezier-vs-arcTo rationale and the source geometry.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Nucleus: filled circle, r = 3.0 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,9 C13.657,9 15,10.343 15,12 C15,13.657 13.657,15 12,15 C10.343,15 9,13.657 9,12 C9,10.343 10.343,9 12,9 Z" />

    <!-- Orbit, top -> right -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2.7"
        android:strokeLineCap="round"
        android:pathData="M12,3.3 C16.805,3.3 20.7,7.195 20.7,12" />

    <!-- Orbit, bottom -> left -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2.7"
        android:strokeLineCap="round"
        android:pathData="M12,20.7 C7.195,20.7 3.3,16.805 3.3,12" />
</vector>
